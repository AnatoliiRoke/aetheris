root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_elsewhere = false:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# The magic-number rule and the naming rules
#
# The balance values live in the database (documentation/game-design/14-balans-i-formuly.md),
# so a bare literal in a rule is almost always a mistake. Named constants and
# configuration parameters are the correct way to express a number.
#
# The rule is implemented by the Aetheris.Analyzers Roslyn analyzer, which is referenced
# from Directory.Build.props.
#
# The rule stays a warning and does not break the build, so that the existing code can be
# cleaned up gradually. The severity is raised to error once the balance code is complete.
dotnet_diagnostic.AETHERIS001.severity = warning
dotnet_diagnostic.AETHERIS001.is_incremental = true

# The parameterized SQL rule (task 00002, section 2.4)
#
# SQL text passed to a method that runs it as is must be a compile-time constant; the
# values travel as parameters. The rule is an error from the start, so the CI build fails on
# any concatenated or interpolated SQL text. It is implemented by the Aetheris.Analyzers
# Roslyn analyzer as well.
dotnet_diagnostic.AETHERIS002.severity = error

dotnet_diagnostic.CA1502.severity = none

# Naming rules for the public surface of the modules.
dotnet_naming_rule.interfaces_should_start_with_i.severity = warning
dotnet_naming_rule.interfaces_should_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_start_with_i.style = begins_with_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Private instance fields are prefixed with an underscore.
#
# The rule covers the instance fields only: a private static field is a constant of
# its type and keeps the PascalCase, as the other constants of the solution do.
#
# The static fields are covered by a second rule with the severity none. Without it
# the tool that checks the format reports the static fields as well, because it does
# not apply the modifier filter of the first rule.
dotnet_naming_rule.private_fields_should_start_with_underscore.severity = warning
dotnet_naming_rule.private_fields_should_start_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_start_with_underscore.style = begins_with_underscore
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = instance
dotnet_naming_style.begins_with_underscore.required_prefix = _
dotnet_naming_style.begins_with_underscore.capitalization = camel_case

dotnet_naming_rule.private_static_fields.severity = none
dotnet_naming_rule.private_static_fields.symbols = private_static_fields
dotnet_naming_rule.private_static_fields.style = begins_with_underscore
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

# Migrations are generated by Entity Framework. Their layout is not ours to change.
#
# This section has to stay last: in an .editorconfig every section applies to every
# file that matches it, so a section placed in the middle would also reset the rules
# that follow it for the whole project.
[src/{Aetheris.Host,Aetheris.World,Aetheris.Planets}/Data/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.IDE0162.severity = none
