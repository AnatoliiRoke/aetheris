<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Aetheris.Research</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The module of the research reads the bodies module through IPlanetsModule, for the level
    of the science centre of the body the research starts from, and keeps the requirements of
    its technologies in the common requirements module. The dependencies go one way only.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Aetheris.Core\Aetheris.Core.csproj" />
    <ProjectReference Include="..\Aetheris.Planets\Aetheris.Planets.csproj" />
    <ProjectReference Include="..\Aetheris.Requirements\Aetheris.Requirements.csproj" />
    <ProjectReference Include="..\Aetheris.World\Aetheris.World.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\research-reference-seed.json" LogicalName="Aetheris.Research.reference-seed.json" />
    <EmbeddedResource Include="Data\admin-reference-texts.json" LogicalName="Aetheris.Research.admin-reference-texts.json" />
  </ItemGroup>

</Project>
