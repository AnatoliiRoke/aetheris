<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Aetheris.Fleet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The module of the fleet reads the world for the races and the bodies, the planets module
    for the shipyard and the limit of the projects, the production module for the catalog and
    the storage of the parts, the economy module for the crew and the credits, the research
    module for the assembly time, the requirements module for the hulls a shipyard level
    opens, and the mail module for the report of a fleet (task 00060). The dependencies go
    one way only.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Aetheris.Core\Aetheris.Core.csproj" />
    <ProjectReference Include="..\Aetheris.Economy\Aetheris.Economy.csproj" />
    <ProjectReference Include="..\Aetheris.Mail\Aetheris.Mail.csproj" />
    <ProjectReference Include="..\Aetheris.Planets\Aetheris.Planets.csproj" />
    <ProjectReference Include="..\Aetheris.Production\Aetheris.Production.csproj" />
    <ProjectReference Include="..\Aetheris.Requirements\Aetheris.Requirements.csproj" />
    <ProjectReference Include="..\Aetheris.Research\Aetheris.Research.csproj" />
    <ProjectReference Include="..\Aetheris.World\Aetheris.World.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\hull-shipyard-levels.json" LogicalName="Aetheris.Fleet.hull-shipyard-levels.json" />
    <EmbeddedResource Include="Data\power-priority-defaults.json" LogicalName="Aetheris.Fleet.power-priority-defaults.json" />
  </ItemGroup>

</Project>
